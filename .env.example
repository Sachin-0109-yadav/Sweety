# ==========================================
# SWEETY ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety_db
DB_USER=postgres
DB_PASSWORD=your_local_postgresql_password

# JWT
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1d

# API
API_PREFIX=/api
